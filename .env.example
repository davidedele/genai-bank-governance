# Copy this file to .env and fill in your own key. Never commit .env itself,
# it's already covered by .gitignore.
#
# Pick which model does the classifying. Defaults to "anthropic" if unset.
# Supported values: anthropic | openai | grok | gemini
LLM_PROVIDER=anthropic

# Optional: override the default model for the chosen provider (model names
# change more often than providers do, so this lets you bump one without
# touching code). Leave unset to use that provider's default from
# providers.py.
# LLM_MODEL=

# Set the key for whichever provider you chose above. You only need the one
# that matches LLM_PROVIDER; the others can stay commented out.

# anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# openai — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# grok (xAI) — https://console.x.ai
# XAI_API_KEY=xai-...

# gemini (Google) — https://aistudio.google.com/apikey
# GEMINI_API_KEY=...

# Load it before running the app or the eval script, e.g.:
#   export $(cat .env | xargs)
#   streamlit run app.py

# Optional prompt-event metadata hook (opt-in). Export these in the shell that
# starts the coding tool, not here. The path must be absolute.
# GENAI_LOG_METADATA=1
# GENAI_EVENT_DB=/absolute/path/to/events.sqlite
