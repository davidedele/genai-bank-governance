# Offline/manual operation is the default. Copy to .env; never publish .env.
ENABLE_LIVE_CLASSIFICATION=0
LLM_PROVIDER=anthropic
# Select an exact model ID available in your own provider account.
LLM_MODEL=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# GEMINI_API_KEY=
# Most model extractions allowed per day (UTC). 0 means no limit. Default: 30.
# DAILY_CLASSIFICATION_LIMIT=30
# Optional local storage location (default: .runtime/register.sqlite):
# GOVERNANCE_DB_PATH=
# Optional Claude Code plugin. Export these in the environment that starts Claude Code,
# and repeat them here so this app reads the same file (see docs/PRIVACY.md).
# GENAI_EVENT_DB=/absolute/path/to/events.sqlite
# GENAI_LOG_METADATA=1       keep only time and prompt length
# GENAI_CAPTURE_PROMPTS=1    also keep the prompt text locally, for review in the workspace
# GENAI_AUTO_CLASSIFY=1      let Claude Code suggest answers in the background
# GENAI_CLASSIFY_LIMIT=30    most suggestions per day (0 for no limit)
# GENAI_CLASSIFY_MODEL=      optional model name for those suggestions
# GOVERNANCE_DB_PATH=/absolute/path/to/register.sqlite   lets the plugin's lookup skill read your register

# Optional demo mode for a server copy that holds made-up data only (see docs/PRIVACY.md)
# GOVERNANCE_DEMO=1
# GOVERNANCE_ALLOWED_HOSTS=your-demo-host.example.com,.example.com
