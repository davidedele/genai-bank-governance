# Offline/manual operation is the default. Copy to .env; never publish .env.
ENABLE_LIVE_CLASSIFICATION=0
LLM_PROVIDER=anthropic
# Select an exact model ID available in your own provider account.
LLM_MODEL=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# GEMINI_API_KEY=
# Optional local storage location (default: .runtime/register.sqlite):
# GOVERNANCE_DB_PATH=
# Metadata hook opt-in must be exported in the shell that starts the coding tool:
# GENAI_LOG_METADATA=1
# GENAI_EVENT_DB=/absolute/path/to/.runtime/events.sqlite
